{
  "name": "clocktower-table-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build && vite build --ssr server/index.ts --outDir dist-server",
    "start": "node dist-server/index.js",
    "debug": "node scripts/debug.mjs",
    "package:local": "npm run build && node scripts/package-local.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:setups": "node --import tsx scripts/generate-setups.ts",
    "test:soak": "vitest run tests/ten-rounds.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0",
    "react-qr-code": "^2.0.15",
    "socket.io-client": "^4.8.1"
  }
}
